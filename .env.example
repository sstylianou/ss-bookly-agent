# Copy this file to .env and fill in your values.

# Required — get yours at console.anthropic.com
ANTHROPIC_API_KEY=your_api_key_here

# Optional — set to your mockapi.io project base URL to use a live REST API
# for order lookups instead of the local dict in mock_data.py.
# Example: https://64a7c8d91f462c736d1af5b8.mockapi.io/api/v1
# Leave blank and the app falls back to mock_data.py automatically.
ORDERS_API_URL=
